<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="AlphaAuthSection" type="Alpha.Auth.Configurations.AlphaAuthSection, Alpha.Auth" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
  </configSections>

  <Fanex.Logging msmqPath="FormatName:DIRECT=http://10.40.40.127/msmq/Private$/entlib" defaultCategory="Alpha-MBC-AF"/>
  <AlphaAuthSection enableAntiXSRF="true" enableSessionValidation="true" enableKickOutWhenSessionInvalid="false" />

  <connectionStrings configSource="Web.ConnectionStrings.config" />
  <appSettings file="Web.AppSettings.config" />

  <system.web>
    <authorization>
      <deny users="?" />
      <allow users="*" />
    </authorization>

    <authentication mode="Forms">

      <forms loginUrl="/site-oldmain/_authorization/signin.aspx"
             defaultUrl="/site-oldmain/index.aspx"
             path="/"
             name=".AGENTFORMSAUTH"
             protection="All" />

    </authentication>

    <customErrors mode="On" defaultRedirect="/site-oldmain/Error.aspx">
      <error statusCode="403" redirect="/site-oldmain/Error.aspx" />
      <error statusCode="404" redirect="/site-oldmain/Error.aspx" />
    </customErrors>
    <sessionState mode="StateServer"
                  timeout="10"
                  stateConnectionString="tcpip=10.40.40.20:42424" />
    <machineKey
			validationKey="A358B9C146344814DDA1038E20B10B8A747F688B4C1380C4C9B7AE538D8C27942F425CE0BD51455C695D3550E2C6E95712EF55B317799D557A3EE0026BF33FBA"
			decryptionKey="CFC2E409280FDF5B1B5AEFAD8834AD84E9EC2F35755289CF565F2B999B2334A5"
			validation="SHA1" decryption="AES" />
  </system.web>

  <runtime>
    <dependentAssembly>
      <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
      <bindingRedirect oldVersion="0.0.0.0-4.5.0.0" newVersion="4.5.0.0" />
    </dependentAssembly>
  </runtime>
  <system.web.extensions>
    <scripting>
      <webServices>
        <jsonSerialization maxJsonLength="2147483644" />
      </webServices>
    </scripting>
  </system.web.extensions>
</configuration>