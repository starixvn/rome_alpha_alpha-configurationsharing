    <Add SettingKey="Age_BetList_SelByDayAll_Mem_WH" SpName="Age_BetList_SelByDayAll_Mem_Old" />
  </Function>

  <Function Name="Bet List - 2" UMFrom="04/06/2021 10:05" UMTo="10/06/2021 14:00" IsActive="true">
