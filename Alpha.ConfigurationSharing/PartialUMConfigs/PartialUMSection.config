    <Add SettingKey="Age_Rpt_MatchWinLossDetail_Agent" />
    <Add SettingKey="Age_Rpt_MatchWinLossDetail_Member" />
    <!--Reports » Consolidation-->
    <Add SettingKey="Age_Rpt_ConsolidatedGroupProductSel" />
