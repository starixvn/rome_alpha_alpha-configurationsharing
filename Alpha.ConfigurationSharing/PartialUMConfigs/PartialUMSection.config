    <Add SettingKey="Age_Rpt_ConsolidatedGroup" />
    <Add SettingKey="Age_Rpt_WinLossDetail_Master" />
    <Add SettingKey="Age_Rpt_WinLossDetail_Agent" />
    <Add SettingKey="Age_Rpt_WinLossDetail_Member" />
  </Function>

