<?xml version="1.0"?>
<PartialUMSection>
  <!--
    UMFrom & UMTo are datetime and format in: dd/mm/yyyy hh:mm
    SettingKey is Key of Stored Procedure NOT Stored Procedure Name
    SpName is for reference
  -->
  <Function Name="Group Win Loss Reports" UMFrom="" UMTo="" IsActive="false">
    <!--Reports » Win Loss-->
    <!--Home page » Balance » Win Loss » Today Win Loss-->
    <!--Home page » Balance » Win Loss » Yesterday-->
