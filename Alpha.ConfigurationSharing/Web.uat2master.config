<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="AlphaAuthSection" type="Alpha.Auth.Configurations.AlphaAuthSection, Alpha.Auth" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="Alpha.NetThrottling" type="Alpha.NetThrottling.NetThrottlingConfiguration, Alpha.NetThrottling" />
    <section name="Alpha.NetThrottling.Whitelist" type="Alpha.NetThrottling.WhitelistConfiguration, Alpha.NetThrottling" />
    <section name="PartialUMSection" type="Alpha.PartialUM.Configurations.PartialUMSection, Alpha.PartialUM" />
  </configSections>
  <Alpha.NetThrottling resolver="Alpha.NetThrottling.Resolvers.HttpErrorResolver, Alpha.NetThrottling"
                       redisConfigurationOptionsKey="RedisConfigurationOptions:Alpha.NetThrottling">
    <keys>
      <add name="Any" path="*" method="*" maxRequests="40" throttleDuration="30" blockDuration="60" filter="Alpha.NetThrottling.Filters.WhitelistSessionFilter, Alpha.NetThrottling" />
      <add name="Main" path="*" method="POST" maxRequests="60" throttleDuration="120" blockDuration="600" filter="" />
      <add name="NewCustomer" path="*" method="POST" maxRequests="10" throttleDuration="600" blockDuration="1800" filter="" />
    </keys>
  </Alpha.NetThrottling>
  <Alpha.NetThrottling.Whitelist custIds="17996464,21984259,20269385,15323100,14771858,24338704,19000014,19562449,19562472,27973467,26912753,23003140,14521687,39061067,27783723,26369026,4664545" />
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.40.40.73\private$\entlib" defaultCategory="Alpha-789y-AF-UAT" />
  <AlphaAuthSection enableAntiXSRF="true" enableSessionValidation="true" enableKickOutWhenSessionInvalid="false" />
  
  <PartialUMSection configSource="PartialUMConfigs\PartialUMSection.config" />

  <connectionStrings configSource="Web.ConnectionStrings.config" />
  <appSettings file="Web.AppSettings.config" />

  <system.web>
    <authorization>
      <deny users="?" />
      <allow users="*" />
    </authorization>

    <authentication mode="Forms">

      <forms loginUrl="/ex-main/_authorization/signin.aspx"
             defaultUrl="/site-main"
             path="/"
             name=".AGENTFORMSAUTH"
             protection="All" />

    </authentication>

    <customErrors mode="Off" defaultRedirect="/ex-main/Error.aspx">
      <error statusCode="403" redirect="/ex-main/Error.aspx" />
      <error statusCode="404" redirect="/ex-main/Error.aspx" />
      <error statusCode="429" redirect="/site-main/Error/Blocked" />
    </customErrors>
    <sessionState mode="StateServer"
                  stateConnectionString="tcpip=10.2.190.41:42428" timeout="10" />
    <machineKey
      validationKey="729F99E0911EE7725CA82F4C224E0FC1BFD6F5B8BE890081C3D399BD6AFBB9D9357A3A10DA5CFF39ED2608A3B955B8467BA7350303D32CD0A396FF275718BEBD"
      decryptionKey="0A50ACDA0F09CCEFA88C7BBD63AFF43F2512906965F8113980702B375C7EA458"
      validation="SHA1" decryption="AES" />
  </system.web>

  <location path="Whoami.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <runtime>
    <dependentAssembly>
      <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
      <bindingRedirect oldVersion="0.0.0.0-4.5.0.0" newVersion="4.5.0.0" />
    </dependentAssembly>
  </runtime>
  <system.web.extensions>
    <scripting>
      <webServices>
        <jsonSerialization maxJsonLength="2147483644" />
      </webServices>
    </scripting>
  </system.web.extensions>
</configuration>
