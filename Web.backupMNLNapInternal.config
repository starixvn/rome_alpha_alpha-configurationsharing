  http://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
	<configSections>
		<section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
		<section name="AlphaAuthSection" type="Alpha.Auth.Configurations.AlphaAuthSection, Alpha.Auth" />
		<section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
	</configSections>
  
	<Fanex.Logging msmqPath="FormatName:DIRECT=http://10.2.98.3/msmq/Private$/entlib" defaultCategory="Alpha-Internal"/>
	<!--<Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.40.40.73\private$\entlib" defaultCategory="Alpha-Internal-UAT" />-->
  
	<AlphaAuthSection enableAntiXSRF="true" enableSessionValidation="true" enableKickOutWhenSessionInvalid="false" />
   
	<connectionStrings configSource="Web.ConnectionStrings.config" />
	<appSettings file="Web.AppSettings.config" /> 
	
	<system.web>
		<authentication mode="Forms">
			<forms loginUrl="/_Authorization/SignIn.aspx" defaultUrl="Index.aspx" path="/" name=".AGENTFORMSAUTH" protection="All" cookieless="UseDeviceProfile" />
		</authentication>	
		<authorization>
			<deny users="?" />
			<allow users="*" />
		</authorization>
		<sessionState mode="StateServer" timeout="10" cookieless="true" stateConnectionString="tcpip=10.2.12.6:42424" />
		<machineKey
		  validationKey="BA78062D26B3C043F580EE0F84ADCDA4769B97E326006DF70E84BE1F09F3212EB596BADE10EB35DE4619CE927EF779E59EF493F0F1476EC289D4E56C192585A2"
		  decryptionKey="8EDD2E0204DA6AD2E7B54498925C51C6AD6E3C65584862D243E7C96A7358614A"
		  validation="SHA1" decryption="AES" />
	</system.web>  
	
	<runtime>
		<dependentAssembly>
			<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
			<bindingRedirect oldVersion="0.0.0.0-4.5.0.0" newVersion="4.5.0.0" />
		</dependentAssembly>
	</runtime>
</configuration>